function mathSetup() {
    declare global PI = 3.1415;
    declare global TAU = 6.2831;
    declare global TAUPROP = 1.6180;
}

function radians(degrees: num): num {
    line result = degrees * PI / 180;

    return result;
}

function degrees(radians: num): num {
    line result = radians * 180 / PI;

    return result;
}

function getSignedAngleBetweenVectors(vector_1: vec, vector_2: vec): num {
    line angle = num.atan2((vector_1.x * vector_2.z) - (vector_1.z * vector_2.x), vector_1.dot(vector_2));
    
    return angle;
}
